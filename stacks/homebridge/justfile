context := "colima-bridged"
tailscale := "/Applications/Tailscale.app/Contents/MacOS/Tailscale"
volumes_dir := join(env("HOME"), ".volumes", "homebridge")
serve_port := "8767"
internal_port := "18767"

default:
    @just --list

# Create the host-side volume dir and seed config.json from the template the
# first time only. Existing config.json (e.g. restored from backup) is left
# untouched.
init:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p {{volumes_dir}}
    if [ ! -f {{volumes_dir}}/config.json ]; then
        if [ ! -f .env ]; then
            echo ".env missing — copy .env.example, fill it in, then re-run" >&2
            exit 1
        fi
        set -a; source .env; set +a
        export INTERNAL_PORT
        envsubst < config.json.template > {{volumes_dir}}/config.json
        echo "Seeded {{volumes_dir}}/config.json from template."
    fi

up: init
    docker --context {{context}} compose up -d

down:
    docker --context {{context}} compose down

restart:
    docker --context {{context}} compose restart

logs:
    docker --context {{context}} compose logs -f

ps:
    docker --context {{context}} compose ps

pull:
    docker --context {{context}} compose pull

shell:
    docker --context {{context}} compose exec homebridge bash

bootstrap:
    @./scripts/bootstrap.sh

# Tailscale serve. Bridged-VM stacks use the VM IP because network_mode: host
# binds inside the VM, not on Mac localhost. Same pattern as adguard.
serve:
    #!/usr/bin/env bash
    set -euo pipefail
    vm_ip=$(colima list | awk '/^bridged[[:space:]]/ && $2 == "Running" {print $NF}')
    if [ -z "$vm_ip" ]; then echo "bridged VM not running"; exit 1; fi
    {{tailscale}} serve --bg --https={{serve_port}} "http://$vm_ip:{{internal_port}}"

backup: down && up
    @../scripts/backup.sh homebridge

restore tarball:
    @../scripts/restore.sh homebridge {{tarball}}
