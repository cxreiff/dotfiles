context := "colima-bridged"
tailscale := "/Applications/Tailscale.app/Contents/MacOS/Tailscale"
volumes_dir := join(env("HOME"), ".volumes", "homebridge")
serve_port := "8767"
internal_port := "18767"

default:
    @just --list

# Create the host-side volume dir and seed config.json from the template the
# first time only. Existing config.json (e.g. restored from backup) is left
# untouched.
init:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p {{volumes_dir}}
    if [ ! -f {{volumes_dir}}/config.json ]; then
        if [ ! -f .env ]; then
            echo ".env missing — copy .env.example, fill it in, then re-run" >&2
            exit 1
        fi
        set -a; source .env; set +a
        export INTERNAL_PORT
        envsubst < config.json.template > {{volumes_dir}}/config.json
        echo "Seeded {{volumes_dir}}/config.json from template."
    fi

up: init
    docker --context {{context}} compose up -d

down:
    docker --context {{context}} compose down

restart:
    docker --context {{context}} compose restart

logs:
    docker --context {{context}} compose logs -f

ps:
    docker --context {{context}} compose ps

pull:
    docker --context {{context}} compose pull

shell:
    docker --context {{context}} compose exec homebridge bash

# Complete the Config UI X setup wizard non-interactively, creating the admin
# user from ADMIN_* in .env. Uses the /api/setup-wizard endpoints (the image
# does NOT ship admin/admin defaults — it ships in setup-wizard mode).
# Idempotent — if the wizard is already complete, the token endpoint 403s and
# we exit 0. Requires `jq` on the host (brew install jq).
bootstrap:
    #!/usr/bin/env bash
    set -euo pipefail
    set -a; source .env; set +a
    command -v jq >/dev/null || { echo "jq required (brew install jq)"; exit 1; }
    vm_ip=$(colima list | awk '/^bridged[[:space:]]/ && $2 == "Running" {print $NF}')
    if [ -z "$vm_ip" ]; then echo "bridged VM not running"; exit 1; fi
    base="http://$vm_ip:{{internal_port}}"
    echo "Waiting for Homebridge UI at $base ..."
    deadline=$(($(date +%s) + 180))
    until curl -fs "$base/api/auth/settings" > /dev/null 2>&1; do
        if [ "$(date +%s)" -ge "$deadline" ]; then
            echo "UI did not become ready within 180s" >&2
            exit 1
        fi
        sleep 2
    done
    wizard_done=$(curl -fs "$base/api/auth/settings" | jq -r '.env.setupWizardComplete')
    if [ "$wizard_done" = "true" ]; then
        echo "Setup wizard already complete — nothing to do."
        exit 0
    fi
    echo "Running setup wizard for user '$ADMIN_USERNAME'..."
    token=$(curl -fs "$base/api/setup-wizard/get-setup-wizard-token" | jq -r '.access_token')
    if [ -z "$token" ] || [ "$token" = "null" ]; then
        echo "Could not obtain setup-wizard token" >&2; exit 1
    fi
    curl -fsX POST "$base/api/setup-wizard/create-first-user" \
        -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
        -d "$(jq -n --arg u "$ADMIN_USERNAME" --arg p "$ADMIN_PASSWORD" \
            '{username:$u, password:$p, name:$u, admin:true}')" > /dev/null
    echo "Bootstrap complete. Log in at https://${PUBLIC_HOST}:${PUBLIC_PORT} as '$ADMIN_USERNAME'."

# Tailscale serve. Bridged-VM stacks use the VM IP because network_mode: host
# binds inside the VM, not on Mac localhost. Same pattern as adguard.
serve:
    #!/usr/bin/env bash
    set -euo pipefail
    vm_ip=$(colima list | awk '/^bridged[[:space:]]/ && $2 == "Running" {print $NF}')
    if [ -z "$vm_ip" ]; then echo "bridged VM not running"; exit 1; fi
    {{tailscale}} serve --bg --https={{serve_port}} "http://$vm_ip:{{internal_port}}"

backup: down && up
    @../scripts/backup.sh homebridge

restore tarball:
    @../scripts/restore.sh homebridge {{tarball}}
