PUBLIC_HOST=YOUR-HOST.YOUR-TAILNET.ts.net
PUBLIC_PORT=8767
INTERNAL_PORT=18767

# Homebridge bridge identity (consumed by config.json.template at first `up`).
# BRIDGE_NAME — friendly name shown in the Home app.
# BRIDGE_USERNAME — MAC-format unique ID; generate once with:
#   printf '%02X:%02X:%02X:%02X:%02X:%02X\n' \
#     $((RANDOM%256|2)) $((RANDOM%256)) $((RANDOM%256)) \
#     $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256))
# HAP_PORT — port for the HomeKit Accessory Protocol server (any free port).
# HOMEKIT_PIN — 8-digit setup pin in XXX-XX-XXX format used during pairing.
#   Generate with: ./scripts/gen-pin.sh (rejects HomeKit reserved pins).
#   DO NOT regenerate after pairing — see "Pairing identity" in README.
BRIDGE_NAME=Homebridge
BRIDGE_USERNAME=CHANGE_ME
HAP_PORT=51826
HOMEKIT_PIN=031-45-154

# Config UI X admin (used by `bootstrap` to replace default admin/admin).
# Leave ADMIN_USERNAME=admin to just rotate the default account's password;
# set anything else to create a new admin and remove the default `admin`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
