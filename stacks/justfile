mod adguard
mod connectome
mod cxagents
mod freshrss
mod homebridge
mod onecli
mod wallabag

default:
    @just --list

# Continues past an individual stack's failure (e.g. `adguard up` failing its
# tailnet-DNS hookup because tailscale/.env is missing or Tailscale is not up
# yet) so onecli/connectome still start at boot. onecli
# precedes connectome (connectome joins onecli's network); cxagents precedes
# connectome (connectome's shell joins the cxagents network when it exists).
# Bring every stack up; prints a summary and exits non-zero if any failed.
up-all:
    #!/usr/bin/env bash
    set -uo pipefail
    failed=()
    for s in adguard freshrss homebridge onecli cxagents connectome wallabag; do
        echo "=== ${s} up ==="
        # Module recipes run with cwd stacks/, so plain `just <stack> up`
        # resolves stacks/justfile (as the other aggregates do). Do NOT use
        # {{justfile()}} here: inside a module it is the ROOT justfile.
        just "$s" up || failed+=("$s")
    done
    if [ "${#failed[@]}" -gt 0 ]; then
        echo "up-all: FAILED: ${failed[*]}" >&2
        exit 1
    fi
    echo "up-all: all stacks up"

# Apps before adguard; connectome before cxagents and onecli: both own a
# network connectome joins (onecli: onecli-agents; cxagents: cxagents).
# DNS-aware shutdown of every stack.
down-all:
    just connectome down
    just cxagents down
    just onecli down
    just wallabag down
    just homebridge down
    just freshrss down
    just adguard down

ps-all:
    just adguard ps
    just connectome ps
    just cxagents ps
    just freshrss ps
    just homebridge ps
    just onecli ps
    just wallabag ps

pull-all:
    just adguard pull
    just connectome pull
    just cxagents pull
    just freshrss pull
    just homebridge pull
    just onecli pull
    just wallabag pull

# connectome before onecli: connectome's tarball is taken while the gateway
# is up; connectome then briefly loses the gateway during onecli's stop/start
# (harmless at 04:00).
# Back up every stack, then GFS-rotate.
backup-all:
    just adguard backup
    just freshrss backup
    just homebridge backup
    just connectome backup
    just onecli backup
    just wallabag backup
    @./scripts/backup-rotate.sh

backup-install:
    @./scripts/backup-install.sh

startup-install:
    @./scripts/startup-install.sh

dns-forward-install:
    @./scripts/dns-forward-install.sh

vm-shared-up:
    colima start -p shared

vm-shared-down:
    colima stop -p shared

vm-bridged-up:
    colima start -p bridged

vm-bridged-down:
    colima stop -p bridged

vm-agents-up:
    colima start -p agents

vm-agents-down:
    colima stop -p agents

bridged-ip-changed:
    @./scripts/bridged-ip-changed.sh

doctor:
    @./scripts/doctor.sh
