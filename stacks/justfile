mod adguard
mod freshrss
mod homebridge
mod wallabag

default:
    @just --list

up-all:
    just adguard up
    just freshrss up
    just homebridge up
    just wallabag up

down-all:
    just wallabag down
    just homebridge down
    just freshrss down
    just adguard down

ps-all:
    just adguard ps
    just freshrss ps
    just homebridge ps
    just wallabag ps

pull-all:
    just adguard pull
    just freshrss pull
    just homebridge pull
    just wallabag pull

vm-shared:
    colima start -p shared

vm-bridged:
    colima start -p bridged

vm-up: vm-shared vm-bridged

doctor:
    @./scripts/doctor.sh
