context := "colima-agents"
tailscale := "/opt/homebrew/bin/tailscale"
serve_port := "8768"
internal_port := "18768"
backups_dir := join(env("HOME"), ".volume-backups", "daily")

default:
    @just --list

# Create/complete .env (prompts for Discord values; generates secrets; re-syncs onecli tokens)
init-env:
    @./scripts/init-env.sh

# Build both images from ~/Developer/connectome clones, copy gateway CA, write sources.lock
build:
    @./scripts/build.sh

# Static assertions against the built images.
image-test:
    @./scripts/image-test.sh

# Write the onecli Codex stub and config into the state volume (once after build)
provision-codex:
    # Note: never use the WebUI "log in again" action; it deletes the stub.
    @./scripts/provision-codex.sh

# Fails clearly if onecli (which owns the onecli-agents network) is not up.
up:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! docker --context {{context}} network inspect onecli-agents >/dev/null 2>&1; then
        echo "connectome: network onecli-agents missing — run \`dotfiles stacks onecli up\` first" >&2
        exit 1
    fi
    docker --context {{context}} compose up -d

down:
    docker --context {{context}} compose down

restart:
    docker --context {{context}} compose restart

ps:
    docker --context {{context}} compose ps -a

# Images are built locally; refresh the base images so the next build uses them.
pull:
    docker --context {{context}} pull node:22-bookworm
    docker --context {{context}} pull oven/bun:1-debian
    docker --context {{context}} pull mcr.microsoft.com/devcontainers/typescript-node:22-bookworm

# Interactive shell in the agent's `shell` container.
shell:
    docker --context {{context}} exec -it connectome-shell bash

# Tail headless.log and failures.log from inside the container (docker logs is empty)
logs:
    docker --context {{context}} exec connectome sh -c 'touch /agent/state/logs/failures.log; tail -n 50 -F /agent/state/data/headless.log /agent/state/logs/failures.log'

serve:
    {{tailscale}} serve --bg --https={{serve_port}} http://localhost:{{internal_port}}

# Quiesces with stop/start (never down/up), prunes llm-calls.*.jsonl older
# than 14 days, keeps the last 10 MiB of headless.log once it passes 50 MiB.
# No-op when the agents VM is down or the volumes are missing.
# Tar the state + workspace volumes to ~/.volume-backups/daily (0600).
backup:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! docker --context {{context}} info >/dev/null 2>&1; then
        echo "connectome: agents VM not running, skipping backup"
        exit 0
    fi
    # Volumes missing (stack never provisioned / cleared): nothing to back up.
    # Skip rather than let `docker run -v` create empty unlabelled volumes and
    # write an empty tarball that rotation would keep.
    for v in connectome_state connectome_workspace; do
        docker --context {{context}} volume inspect "$v" >/dev/null 2>&1 \
            || { echo "connectome: volume $v missing, skipping backup"; exit 0; }
    done
    # Restart only what was running (an intentionally stopped stack stays
    # stopped), and never fail the recipe on the restart: a failed backup-all
    # step would skip every later stack's backup and the rotation.
    running=$(docker --context {{context}} compose ps -q --status running)
    restart() {
        [ -n "$running" ] || return 0
        docker --context {{context}} compose start \
            || echo "connectome: WARNING: restart after backup failed (dotfiles stacks connectome up)" >&2
    }
    trap restart EXIT
    docker --context {{context}} compose stop
    docker --context {{context}} run --rm -v connectome_state:/s alpine sh -c '
        find /s/data -maxdepth 1 -name "llm-calls.*.jsonl" -mtime +14 -print -delete
        log=/s/data/headless.log
        if [ -f "$log" ] && [ "$(stat -c %s "$log")" -gt 52428800 ]; then
            tail -c 10485760 "$log" > /s/data/.headless.tail && cat /s/data/.headless.tail > "$log" && rm -f /s/data/.headless.tail
            echo "truncated headless.log to last 10 MiB"
        fi'
    mkdir -p "{{backups_dir}}"
    dst="{{backups_dir}}/connectome-$(date +%Y-%m-%d).tgz"
    docker --context {{context}} run --rm \
        -v connectome_state:/src/state:ro \
        -v connectome_workspace:/src/workspace:ro \
        -v "{{backups_dir}}":/dst \
        alpine sh -c "umask 077 && cd /src && tar czf /dst/$(basename "$dst") state workspace"
    # Plaintext agent state / the gateway CA key: owner-only. The umask in the
    # container sets it at creation (a host-side chmod can be undone when the
    # VM flushes the file's attributes back over virtiofs); chmod as a backstop.
    chmod 600 "$dst"
    echo "$dst"

# Restore state + workspace from a tarball; refuses non-empty volumes.
restore tarball:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! docker --context {{context}} info >/dev/null 2>&1; then
        echo "connectome: agents VM not running (run dotfiles stacks vm-agents-up)" >&2
        exit 1
    fi
    [ -f "{{tarball}}" ] || { echo "connectome: tarball not found: {{tarball}}" >&2; exit 1; }
    docker --context {{context}} compose stop 2>/dev/null || true
    # On refusal/failure, bring the (untouched) stack back.
    trap 'docker --context {{context}} compose start 2>/dev/null || true' ERR
    abs="$(cd "$(dirname "{{tarball}}")" && pwd)/$(basename "{{tarball}}")"
    # Fresh device: create the volumes with compose's labels (adopted by
    # compose without warnings) and WITHOUT image copy-up — `compose create`
    # would pre-populate workspace with the shell image's outbox/ dir and the
    # emptiness check below would then refuse.
    for v in state workspace; do
        docker --context {{context}} volume inspect "connectome_${v}" >/dev/null 2>&1 \
            || docker --context {{context}} volume create \
                --label com.docker.compose.project=connectome \
                --label com.docker.compose.volume="${v}" "connectome_${v}" >/dev/null
    done
    docker --context {{context}} run --rm \
        -v connectome_state:/dst/state \
        -v connectome_workspace:/dst/workspace \
        -v "$(dirname "$abs")":/src:ro \
        alpine sh -c "
            # An existing-but-unused workspace may hold only an empty outbox/
            # mountpoint (copied up from the shell image); treat that as empty.
            if [ -n \"\$(ls -A /dst/state 2>/dev/null)\" ] \
               || [ -n \"\$(ls -A /dst/workspace 2>/dev/null | grep -vx outbox)\" ] \
               || [ -n \"\$(ls -A /dst/workspace/outbox 2>/dev/null)\" ]; then
                echo 'connectome: target volumes are non-empty; refusing to clobber. Manually clear and retry.' >&2
                exit 1
            fi
            cd /dst && tar xzpf /src/$(basename "{{tarball}}")"
    trap - ERR
    # cwd is stacks/connectome (this module's dir), so `just up` resolves the
    # connectome justfile; {{justfile()}} would be the ROOT justfile.
    just up

