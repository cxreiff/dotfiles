PUBLIC_HOST=YOUR-HOST.YOUR-TAILNET.ts.net
PUBLIC_PORT=8766
INTERNAL_PORT=18766

# Symfony app secret — generate with: openssl rand -hex 32
WALLABAG_SECRET=CHANGE_ME

# Friendly name shown in 2FA / TOTP issuer
SERVER_NAME=wallabag

# Used by `bootstrap` recipe to create the real admin and disable
# the hardcoded default `wallabag:wallabag` account.
ADMIN_USERNAME=admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=CHANGE_ME
