context := "colima-shared"
tailscale := "/Applications/Tailscale.app/Contents/MacOS/Tailscale"
serve_port := "8766"
internal_port := "18766"
volumes_dir := join(env("HOME"), ".volumes", "wallabag")

default:
    @just --list

init:
    mkdir -p {{volumes_dir}}/data {{volumes_dir}}/images

up: init
    docker --context {{context}} compose up -d

down:
    docker --context {{context}} compose down

restart:
    docker --context {{context}} compose restart

logs:
    docker --context {{context}} compose logs -f

ps:
    docker --context {{context}} compose ps

pull:
    docker --context {{context}} compose pull

shell:
    docker --context {{context}} compose exec wallabag sh

# Replace the hardcoded default `wallabag:wallabag` admin with the credentials
# from .env. Idempotent: safe to re-run.
bootstrap:
    #!/usr/bin/env bash
    set -euo pipefail
    set -a; source .env; set +a
    echo "Waiting for wallabag to respond..."
    deadline=$(($(date +%s) + 180))
    until docker --context {{context}} compose exec -T wallabag curl -fs --user-agent healthcheck http://localhost/api/info > /dev/null 2>&1; do
        if [ "$(date +%s)" -ge "$deadline" ]; then
            echo "wallabag did not become ready within 180s" >&2
            exit 1
        fi
        sleep 2
    done
    echo "Creating admin user '$ADMIN_USERNAME'..."
    docker --context {{context}} compose exec -T wallabag \
        bin/console fos:user:create "$ADMIN_USERNAME" "$ADMIN_EMAIL" "$ADMIN_PASSWORD" --super-admin --env=prod -n \
        || echo "(user '$ADMIN_USERNAME' already exists; skipping)"
    if [ "$ADMIN_USERNAME" != "wallabag" ]; then
        echo "Deactivating default 'wallabag' user..."
        docker --context {{context}} compose exec -T wallabag \
            bin/console fos:user:deactivate wallabag --env=prod -n \
            || echo "(default 'wallabag' user already deactivated or removed)"
    fi
    echo "Bootstrap complete. Log in at https://${PUBLIC_HOST}:${PUBLIC_PORT} as '$ADMIN_USERNAME'."

serve:
    {{tailscale}} serve --bg --https={{serve_port}} http://localhost:{{internal_port}}

backup: down && up
    @../scripts/backup.sh wallabag

restore tarball:
    @../scripts/restore.sh wallabag {{tarball}}
