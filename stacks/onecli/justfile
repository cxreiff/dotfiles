context := "colima-agents"
backups_dir := join(env("HOME"), ".volume-backups", "daily")

default:
    @just --list

# Start the v2 stack and wait for services healthy (migrations exit 0)
up:
    docker --context {{context}} compose up -d --wait

# Refuses while connectome containers exist: compose down would try to remove
# the onecli-agents network they are attached to. `down-all` orders this.
down:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -n "$(docker --context {{context}} ps -aq --filter label=com.docker.compose.project=connectome)" ]; then
        echo "onecli: connectome containers exist — run \`dotfiles stacks connectome down\` first" >&2
        exit 1
    fi
    docker --context {{context}} compose down

restart:
    docker --context {{context}} compose restart

logs:
    docker --context {{context}} compose logs -f

ps:
    docker --context {{context}} compose ps -a

pull:
    docker --context {{context}} compose pull

shell:
    docker --context {{context}} compose exec api sh

# Generate vault secrets into .env if absent (never prints values); chmod 600
init-env:
    @./scripts/init-env.sh

# Fresh-vault account bootstrap (sign up/sign in, get API key, point CLI)
bootstrap:
    @./scripts/bootstrap.sh

# Import a `codex login` as the `openai` OAuth secret (one-time, or to replace)
import-openai *args:
    @./scripts/import-openai.sh {{args}}

# Create/update connectome agents, policy rules and secret grants (optional arg: rule 1 limit)
policy rate_limit="":
    @./scripts/policy.sh {{rate_limit}}

# Gateway probes for identity/policy acceptance checks (read-only)
probe:
    @./scripts/probe.sh

# Gateway request log for the last N minutes (from Postgres; not docker logs)
requests $minutes="15":
    #!/usr/bin/env bash
    set -euo pipefail
    [[ "$minutes" =~ ^[0-9]+$ ]] || { echo "requests: minutes must be an integer" >&2; exit 2; }
    sql="select to_char(created_at, 'HH24:MI:SS'), agent_id, method, host, path, status
         from request_logs where created_at > now() - interval '$minutes minutes'
         order by created_at;"
    printf '%s' "$sql" | docker --context {{context}} compose exec -T postgres \
        sh -c 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -At -F " " -f -'

# Snapshot pgdata + app-data (quiesces with stop/start, not down/up)
backup:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! docker --context {{context}} info >/dev/null 2>&1; then
        echo "onecli: agents VM not running, skipping backup"
        exit 0
    fi
    # Volumes missing (stack never provisioned / cleared): nothing to back up.
    # Skip rather than let `docker run -v` create empty unlabelled volumes and
    # write an empty tarball that rotation would keep.
    for v in onecli_pgdata onecli_app-data; do
        docker --context {{context}} volume inspect "$v" >/dev/null 2>&1 \
            || { echo "onecli: volume $v missing, skipping backup"; exit 0; }
    done
    # Restart only what was running (an intentionally stopped stack stays
    # stopped), and never fail the recipe on the restart: a failed backup-all
    # step would skip every later stack's backup and the rotation.
    running=$(docker --context {{context}} compose ps -q --status running)
    restart() {
        [ -n "$running" ] || return 0
        docker --context {{context}} compose start \
            || echo "onecli: WARNING: restart after backup failed (dotfiles stacks onecli up)" >&2
    }
    docker --context {{context}} compose stop
    trap restart EXIT
    mkdir -p "{{backups_dir}}"
    dst="{{backups_dir}}/onecli-$(date +%Y-%m-%d).tgz"
    docker --context {{context}} run --rm \
        -v onecli_pgdata:/src/pgdata:ro \
        -v onecli_app-data:/src/app-data:ro \
        -v "{{backups_dir}}":/dst \
        alpine \
        sh -c "cd /src && tar czf /dst/$(basename "$dst") pgdata app-data"
    echo "$dst"

# Restore vault from tarball; refuses to overwrite a populated volume.
restore tarball:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! docker --context {{context}} info >/dev/null 2>&1; then
        echo "onecli: agents VM not running (run dotfiles stacks vm-agents-up)" >&2
        exit 1
    fi
    if [ ! -f "{{tarball}}" ]; then
        echo "onecli: tarball not found: {{tarball}}" >&2
        exit 1
    fi
    docker --context {{context}} compose stop
    # On refusal/failure, bring the (untouched) stack back.
    trap 'docker --context {{context}} compose start' ERR
    # Fresh device: create the volumes with compose's labels (so compose
    # adopts them without "not created by Docker Compose" warnings) and
    # without image copy-up (which would make them non-empty).
    for v in pgdata app-data; do
        docker --context {{context}} volume inspect "onecli_${v}" >/dev/null 2>&1 \
            || docker --context {{context}} volume create \
                --label com.docker.compose.project=onecli \
                --label com.docker.compose.volume="${v}" "onecli_${v}" >/dev/null
    done
    abs="$(cd "$(dirname "{{tarball}}")" && pwd)/$(basename "{{tarball}}")"
    docker --context {{context}} run --rm \
        -v onecli_pgdata:/dst/pgdata \
        -v onecli_app-data:/dst/app-data \
        -v "$(dirname "$abs")":/src:ro \
        alpine \
        sh -c "
            if [ -n \"\$(ls -A /dst/pgdata 2>/dev/null)\" ] || [ -n \"\$(ls -A /dst/app-data 2>/dev/null)\" ]; then
                echo 'onecli: target volumes are non-empty; refusing to clobber. Manually clear and retry.' >&2
                exit 1
            fi
            cd /dst && tar xzf /src/$(basename "{{tarball}}")
        "
    trap - ERR
    docker --context {{context}} compose up -d --wait
