context := "colima-bridged"
tailscale := "/Applications/Tailscale.app/Contents/MacOS/Tailscale"
volumes_dir := join(env("HOME"), ".volumes", "adguard")
serve_port := "8689"
internal_port := "18689"

default:
    @just --list

init:
    mkdir -p {{volumes_dir}}/conf {{volumes_dir}}/work

up: init
    docker --context {{context}} compose up -d
    # shell `&&`: tailnet-dns flips on only if wait-healthy succeeded; both
    # share one line so a wait-healthy failure surfaces as the recipe's exit.
    @./scripts/wait-healthy.sh && ./scripts/tailnet-dns.sh on

down:
    @./scripts/tailnet-dns.sh off
    docker --context {{context}} compose down

restart:
    docker --context {{context}} compose restart

logs:
    docker --context {{context}} compose logs -f

ps:
    docker --context {{context}} compose ps

pull:
    docker --context {{context}} compose pull

shell:
    docker --context {{context}} compose exec adguardhome sh

serve:
    #!/usr/bin/env bash
    set -euo pipefail
    vm_ip=$(colima list | awk '/^bridged[[:space:]]/ && $2 == "Running" {print $NF}')
    if [ -z "$vm_ip" ]; then echo "bridged VM not running"; exit 1; fi
    {{tailscale}} serve --bg --https={{serve_port}} "http://$vm_ip:{{internal_port}}"

advertise:
    #!/usr/bin/env bash
    set -euo pipefail
    vm_ip=$(colima list | awk '/^bridged[[:space:]]/ && $2 == "Running" {print $NF}')
    if [ -z "$vm_ip" ]; then echo "bridged VM not running"; exit 1; fi
    {{tailscale}} set --advertise-routes=$vm_ip/32
    echo
    echo "Advertised $vm_ip/32 from this node."
    echo "Approve at https://login.tailscale.com/admin/machines (find this host, edit route settings)."
    echo "Then set Global nameserver to $vm_ip in https://login.tailscale.com/admin/dns"

backup:
    @../scripts/backup.sh adguard

restore tarball:
    @../scripts/restore.sh adguard {{tarball}}

tailnet-dns-on:
    @./scripts/tailnet-dns.sh on

tailnet-dns-off:
    @./scripts/tailnet-dns.sh off

tailnet-dns-status:
    @./scripts/tailnet-dns.sh status
